# OtterView Knowledge - 环境配置模板
# 复制此文件为 .env 并填入实际配置

# =============================================================================
# 环境配置
# =============================================================================
# 环境模式：development(开发模式), production(生产模式), test(测试模式)
ENVIRONMENT=production

# =============================================================================
# OpenMP配置 - 解决多库冲突问题
# =============================================================================
# 允许重复加载OpenMP库（解决torch、scikit-learn等库的冲突）
KMP_DUPLICATE_LIB_OK=TRUE
# 设置OpenMP线程数
OMP_NUM_THREADS=1

# =============================================================================
# 数据库配置
# =============================================================================
# 数据库类型：mysql/postgresql/postgres/sqlite
DB_DATABASE_TYPE=postgresql
# 兼容历史变量名（这些变量同样用于PostgreSQL连接）
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=5432
DB_MYSQL_USER=otterview
DB_MYSQL_PASSWORD=
DB_MYSQL_DATABASE=otterview_knowledge

# 启动期数据库动作（默认更保守，避免服务启动时直接 create_all / 跑迁移）
STARTUP_CHECK_DATABASE_ON_STARTUP=true
STARTUP_INITIALIZE_DATABASE_ON_STARTUP=false
STARTUP_RUN_DATABASE_MIGRATIONS_ON_STARTUP=false
STARTUP_SEED_LLM_CONFIG_ON_STARTUP=false
STARTUP_FAIL_FAST_ON_STARTUP_ERROR=true

# =============================================================================
# JWT配置
# =============================================================================
SECURITY_SECRET_KEY=
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# 向量数据库配置
# =============================================================================
# 向量数据库类型：faiss/milvus/pgvector
VECTOR_DB_TYPE=pgvector
VECTOR_DB_DIMENSION=1536
# 视觉向量维度（image_to_image / visual_similarity）
VISUAL_VECTOR_DIMENSION=512
# 兼容旧配置（将逐步废弃）
# CLIP_VECTOR_DIMENSION=512
# 兼容旧变量名：VECTOR_VECTOR_DB_TYPE / VECTOR_VECTOR_DB_DIMENSION
VECTOR_FAISS_INDEX_PATH=./faiss_index
VECTOR_FAISS_INDEX_TYPE=IVFFlat

# pgvector 说明：
# - 使用主库 PostgreSQL + pgvector 扩展
# - 需要数据库具备执行 `CREATE EXTENSION vector` 权限（或提前安装好扩展）

# ==================== pgvector 索引优化（可选） ====================
# 未建索引时检索会接近全表扫描；默认自动创建 ANN 索引（优先 HNSW，回退 IVFFLAT）
PGVECTOR_AUTO_INDEX=1
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_IVFFLAT_LISTS_KNOWLEDGE=200

# --- Milvus（可选，VECTOR_DB_TYPE=milvus）配置 ---
VECTOR_MILVUS_HOST=your_milvus_host
VECTOR_MILVUS_PORT=19530
VECTOR_MILVUS_USER=
VECTOR_MILVUS_DB=default
VECTOR_MILVUS_PASSWORD=

# =============================================================================
# 图数据库配置 - PostgreSQL（默认）/ Neo4j（兼容）
# =============================================================================
# 启用知识图谱功能
GRAPH_DB_ENABLED=false
# 图存储后端：postgres（默认） / neo4j（兼容）
GRAPH_DB_TYPE=postgres
# 当 GRAPH_DB_TYPE=postgres 时使用的 schema
GRAPH_PG_SCHEMA=public
# Postgres 图存储命名空间（用于隔离；不需要隔离可保持 default）
GRAPH_NAMESPACE=default

# --- Neo4j（仅当 GRAPH_DB_TYPE=neo4j 时需要）连接信息 ---
GRAPH_NEO4J_URI=bolt://your_neo4j_host:7687
GRAPH_NEO4J_USERNAME=neo4j
GRAPH_NEO4J_PASSWORD=your_neo4j_password
GRAPH_NEO4J_DATABASE=neo4j
# 连接池配置
GRAPH_NEO4J_MAX_CONNECTION_POOL_SIZE=10
GRAPH_NEO4J_CONNECTION_TIMEOUT=5.0

# --- Postgres（GRAPH_DB_TYPE=postgres）说明 ---
# 默认知识图谱实现使用主库 PostgreSQL 的表存储（kg_nodes/kg_edges），因此需要：
# DB_DATABASE_TYPE=postgresql  且数据库具备创建 schema/table 权限。

# =============================================================================
# LLM配置
# =============================================================================
# LLM服务提供商：openai/local
# - `openai` 表示 OpenAI 官方或任意远端 OpenAI-compatible 接口
# - `local` 表示本地/内网部署的 OpenAI-compatible 接口
# - Qwen/DeepSeek/GLM 等都只作为模型名，不再作为独立 provider
LLM_PROVIDER=openai

# OpenAI配置
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=
# 兼容历史变量：LLM_BASE_URL 等同于 OPENAI_API_BASE，LLM_MODEL 等同于 OPENAI_MODEL_NAME
# LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_AUTH_MODE=bearer
OPENAI_API_USERNAME=
OPENAI_API_PASSWORD=

# 本地LLM配置（可选）
LOCAL_LLM_ENDPOINT=
LOCAL_LLM_MODEL_NAME=
LOCAL_LLM_AUTH_MODE=none
LOCAL_LLM_API_KEY=
LOCAL_LLM_USERNAME=
LOCAL_LLM_PASSWORD=

# 知识图谱大模型抽取配置（可选，默认值适用于多数长文档）
# 分块大小与重叠字符数；长文档会均匀采样到 KG_LLM_MAX_CHUNKS 个分块以内。
KG_LLM_CHUNK_SIZE=2600
KG_LLM_CHUNK_OVERLAP=180
KG_LLM_MAX_CHUNKS=12
# 单个分块最多抽取的实体/关系数量。
KG_LLM_ENTITIES_PER_CHUNK=8
KG_LLM_RELATIONS_PER_CHUNK=8
KG_LLM_MAX_TOKENS=1600
# 合并后保留的实体/关系上限及置信度阈值。
KG_LLM_MAX_ENTITIES=40
KG_LLM_MAX_RELATIONS=80
KG_LLM_MIN_VALID_ENTITIES=2
KG_LLM_MIN_ENTITY_CONFIDENCE=0.58
KG_LLM_MIN_RELATION_CONFIDENCE=0.60
# 模型离线时快速降级，避免每个分块都等待 LLM 超时。
KG_LLM_PREFLIGHT_ENABLED=1
KG_LLM_PREFLIGHT_TIMEOUT=5.0
KG_LLM_MAX_CONSECUTIVE_FAILURES=1

# =============================================================================
# VLM（视觉模型）配置
# =============================================================================
# VLM_PROVIDER=openai
# VLM_MODEL_NAME=gpt-4.1-mini
# VLM_API_BASE=https://api.openai.com/v1
# VLM_API_AUTH_MODE=bearer
# VLM_API_KEY=your_vlm_api_key
# VLM_API_USERNAME=
# VLM_API_PASSWORD=
# VLM_MAX_IMAGES_PER_BATCH=10
# 单次图片识别同时生成摘要和标签，校验通过后跳过第二次摘要请求。
VLM_REUSE_IMAGE_ANALYSIS=true
VLM_IMAGE_REQUEST_TIMEOUT=180
VLM_IMAGE_MAX_RETRIES=1
VLM_IMAGE_CACHE_ENABLED=true
VLM_IMAGE_CACHE_TTL_SECONDS=86400
VLM_IMAGE_CACHE_VERSION=1
# deferred：先入库可检索，再由持久化后台任务补齐AI摘要和图谱；sync：等待全部完成。
UPLOAD_PROCESSING_MODE=deferred
# 单次请求可用 parseOptions.processing_mode=deferred/sync 覆盖。
UPLOAD_ENRICHMENT_WORKER_ENABLED=true
UPLOAD_ENRICHMENT_POLL_SECONDS=2
UPLOAD_ENRICHMENT_MAX_ATTEMPTS=3
# 默认保留原图和服务端输出预算；按样本质量与耗时评测后再启用限制。
# VLM_IMAGE_MAX_EDGE=1280
# VLM_IMAGE_JPEG_QUALITY=85
# VLM_MAX_OUTPUT_TOKENS=1024
#
# --- SE7 盒子 Qwen3-VL（OpenAI-compatible）示例 ---
# VLM_PROVIDER=local
# VLM_MODEL_NAME=qwen3-vl-4b-instruct
# VLM_API_BASE=http://127.0.0.1:8899/v1
# VLM_API_AUTH_MODE=none
# VLM_API_KEY=

# =============================================================================
# Audio（音频转写）配置
# =============================================================================
# AUDIO_TRANSCRIBE_PROVIDER=disabled
# AUDIO_TRANSCRIBE_MODEL_NAME=whisper-1
# AUDIO_TRANSCRIBE_API_BASE=https://api.openai.com/v1
# AUDIO_TRANSCRIBE_AUTH_MODE=bearer
# AUDIO_TRANSCRIBE_API_KEY=your_audio_api_key
# AUDIO_TRANSCRIBE_USERNAME=
# AUDIO_TRANSCRIBE_PASSWORD=
# AUDIO_TRANSCRIBE_LANGUAGE=zh
# AUDIO_TRANSCRIBE_PROMPT=请准确转录这段音频的内容
#
# --- 本地 / OpenAI-compatible 音频转写示例 ---
# AUDIO_TRANSCRIBE_PROVIDER=local
# AUDIO_TRANSCRIBE_MODEL_NAME=whisper-1
# AUDIO_TRANSCRIBE_API_BASE=http://127.0.0.1:8899/v1
# AUDIO_TRANSCRIBE_AUTH_MODE=basic
# AUDIO_TRANSCRIBE_USERNAME=your-user
# AUDIO_TRANSCRIBE_PASSWORD=your-password

# =============================================================================
# Embedding模型配置
# =============================================================================
# Embedding提供商：openai/local
# - 底层即使是 qwen3-embedding，也应配置为 openai/local 之一
EMBEDDING_PROVIDER=openai

# OpenAI-compatible Embedding 模型名
EMBEDDING_OPENAI_EMBEDDING_MODEL=

# 本地Embedding配置（可选）
EMBEDDING_LOCAL_EMBEDDING_URL=
EMBEDDING_LOCAL_EMBEDDING_MODEL=
EMBEDDING_LOCAL_EMBEDDING_AUTH_MODE=none
EMBEDDING_LOCAL_EMBEDDING_API_KEY=
EMBEDDING_LOCAL_EMBEDDING_USERNAME=
EMBEDDING_LOCAL_EMBEDDING_PASSWORD=

# =============================================================================
# Rerank模型配置
# =============================================================================
# Rerank提供商：openai/local/disabled
# - OpenAI-compatible 私有部署同样应走 `openai` 或 `local`
RERANK_PROVIDER=disabled

# OpenAI-compatible Rerank 模型名
RERANK_OPENAI_RERANK_MODEL=text-embedding-ada-002

# 本地Rerank配置（可选）
RERANK_LOCAL_RERANK_URL=
RERANK_LOCAL_RERANK_MODEL=
RERANK_LOCAL_RERANK_AUTH_MODE=none
RERANK_LOCAL_RERANK_API_KEY=
RERANK_LOCAL_RERANK_USERNAME=
RERANK_LOCAL_RERANK_PASSWORD=

# =============================================================================
# Redis 缓存配置
# =============================================================================
# 可选：不配置则禁用缓存
# 推荐：使用 URL 一次性配置
REDIS_URL=
# 或使用分项配置（REDIS_URL 优先生效）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# 健康检查配置
# =============================================================================
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_VECTOR_DB=true
HEALTH_CHECK_GRAPH_DB=true
HEALTH_TIMEOUT_SECONDS=3.0

# =============================================================================
# 服务器配置
# =============================================================================
HOST=127.0.0.1
PORT=8006

# =============================================================================
# API日志配置
# =============================================================================
# 启用API请求日志记录
API_LOGGING_ENABLED=false
# API日志保留天数
API_LOG_RETENTION_DAYS=30

# =============================================================================
# 开发调试配置
# =============================================================================
# 跳过身份验证（开发模式）
SKIP_AUTH=false
# 开发模式
DEV_MODE=false
# SQL查询日志
SQLALCHEMY_ECHO=false

# Asset download/upload limit (100 MiB). Private networks blocked by default.
SECURITY_MAX_RESOURCE_BYTES=104857600
# Explicit trust exception for an internal object-storage host only (JSON array).
SECURITY_DOWNLOAD_ALLOWED_HOSTS=[]

# 单图默认先尝试本地 OCR；文字/置信度不足或服务不可用时回退视觉模型。
# 原生/host-network 部署可用此地址；跨容器时填 OCR 服务内网地址。
IMAGE_OCR_ENABLED=false
IMAGE_OCR_API_URL=http://127.0.0.1:8014/ocr
IMAGE_OCR_VERSION=rapidocr-v4-1
IMAGE_OCR_TIMEOUT=20
IMAGE_OCR_MIN_CONFIDENCE=0.9
IMAGE_OCR_MIN_BLOCK_CONFIDENCE=0.8
IMAGE_OCR_MIN_CHARS=20
IMAGE_OCR_MIN_BLOCKS=2
# 场景理解优先：单次请求设置 parseOptions.image_processing_mode=vision。
