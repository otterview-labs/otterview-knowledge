# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be added to the global gitignore or merged into this project gitignore.  For a PyCharm
#  project, it is possible to exclude the folder .idea/ below if you are not interested in having
#  a common PyCharm configuration across the projects.
.idea/

# Project-specific ignores
# Uploads directory
uploads/

# FAISS index files
faiss_index/
*.index

# Vector database files
*.db
*.sqlite

# Logs - 统一到storage/logs
logs/
storage/logs/*
!storage/logs/.gitkeep
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
temp/

# Backup files
*.bak*

# Application specific
# Configuration files with sensitive data
config/local_*.py
*.local.env

__pycache__/
*.pyc
*.pyo

# 忽略视频目录
static/video/

# 忽略根目录下临时 test 开头文件，但保留正式测试目录
/test*
!/tests/
!/tests/**
tests/**/__pycache__/
tests/**/*.pyc

# 忽略所有markdown文件，但保留重要文档


# 忽略备份和临时脚本
*.backup
*.bak
deploy_*.py
auto_*.py
check_*.py
fix_*.py
analyze_*.py
sync_*.py
verify_*.py
debug_*.py
trace_*.py
/test_*.py
install_*.py
compare_*.py
explain_*.py
find_*.py
init_*.py
monitor_*.py
optimize_*.py
quick_*.py
