simple_*.py


# 服务相关
service.log
error.log
nohup.out
*.service
!deploy/*.service

# 环境配置（敏感信息）
.env
.env.*
!.env.example

# 存储目录
storage/uploads/*
storage/temp/*
storage/data/*
storage/indices/*
storage/workspace/*
!storage/*/.gitkeep

# 关键帧输出（运行时生成，不应入库）
storage/static/images/key_frame/**
!storage/static/images/key_frame/.gitkeep

# Local public-release artifacts and private audit material
public-snapshot*/
private-backups/

# Local OtterView account and session database
.workspace-auth/

# Application modules are source, including init_* and simple_* helpers.
!/app/**/*.py
